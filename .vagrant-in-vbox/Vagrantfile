Vagrant.configure("2") do |config|
  config.vm.box = "archlinux/archlinux"

  config.vm.provider "virtualbox" do |vb|
    vb.gui = true
    vb.memory = "3584"
    vb.cpus = "2"
    vb.customize ["modifyvm", :id, "--vram", "128"]
    vb.customize ["modifyvm", :id, "--audio", "default", "--audiocontroller", "hda"]
    vb.customize ["modifyvm", :id, "--audio-out", "on"]
    vb.customize ["modifyvm", :id, "--cpuexecutioncap", "80"]

    # Enable bidirectional clipboard and drag-and-drop
    vb.customize ["modifyvm", :id, "--clipboard", "bidirectional"]
    vb.customize ["modifyvm", :id, "--draganddrop", "bidirectional"]
  end

  # Configure shared folders
  config.vm.synced_folder "D:/archlinux/dabham", "/vagrant_shared", type: "virtualbox"

  config.vm.provision "shell", inline: <<-SHELL
    # Update system (keep as-is)
    sudo pacman -Syu --noconfirm

    # NEW: Properly install VirtualBox Guest Utils with X11 support
    sudo pacman -Rns --noconfirm virtualbox-guest-utils-nox || true
    sudo pacman -S --noconfirm virtualbox-guest-utils
    sudo systemctl enable vboxservice --now
  SHELL

  # Copy larbs.sh to /tmp on the VM and execute it.
  config.vm.provision "file", source: "larbs.sh", destination: "/tmp/larbs.sh"
  config.vm.provision "file", source: "progs.csv", destination: "/tmp/progs.csv"
  config.vm.provision "shell", inline: <<-SHELL
    chmod +x /tmp/larbs.sh
    /tmp/larbs.sh
  SHELL
end